{
  "name": "clippyxam",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-agents.mjs",
    "prebuild": "node scripts/prepare-agents.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "check": "tsc --noEmit",
    "test:desktop": "node --test electron/*.test.cjs",
    "audit:agents": "node scripts/audit-agents.mjs",
    "test:launcher": "node --test scripts/*.test.mjs",
    "verify": "npm run check && npm test && npm run test:desktop && npm run test:launcher && npm run audit:agents",
    "portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-voice.ps1 && npm run build && electron-builder --win portable --x64 --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "clippyjs": "0.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "description": "Minimal NT-style desktop companion with free-only OpenRouter chat",
  "author": "clippyXam contributors",
  "build": {
    "appId": "ai.clippyxam",
    "productName": "clippyXam",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "electron/icon.png",
      "!electron/*.test.cjs",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "PORTABLE-RU.md",
        "to": "PORTABLE-RU.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "clippyXam-${version}-win-x64-portable.exe",
      "requestExecutionLevel": "user"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "voice-engine/runtime",
        "to": "voice-engine"
      }
    ]
  }
}
