{
  "name": "clippyxam",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-agents.mjs",
    "prebuild": "node scripts/prepare-agents.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "check": "tsc --noEmit",
    "test:desktop": "node --test electron/*.test.cjs",
    "audit:agents": "node scripts/audit-agents.mjs",
    "test:launcher": "node --test scripts/*.test.mjs",
    "verify": "npm run check && npm test && npm run test:desktop && npm run test:launcher && npm run audit:agents"
  },
  "dependencies": {
    "clippyjs": "0.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
